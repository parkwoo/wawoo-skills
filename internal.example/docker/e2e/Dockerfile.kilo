# Kilo CLI + Python（MCP stdio 用）。API キーは実行時に渡す。
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN npm install -g @kilocode/cli@7
WORKDIR /work
# イメージビルド時はリポジトリ未マウントのため検証は compose の smoke サービスで行う
ENTRYPOINT ["kilo"]
